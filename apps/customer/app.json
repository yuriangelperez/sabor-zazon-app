{
  "expo": {
    "name": "Sabor y Sazón",
    "slug": "sabor-y-sazon-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saborysazon",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "ios": {
      "bundleIdentifier": "com.saborysazon.pedidos",
      "supportsTablet": true
    },
    "android": {
      "package": "com.saborysazon.pedidos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#09090b"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#09090b"
        }
      ]
    ]
  }
}
